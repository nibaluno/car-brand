<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CarBrand.Mobile.ViewModels"
    x:DataType="models:AddCarBrandViewModel"
    x:Class="CarBrand.Mobile.Pages.AddCarBrandPage"
    Title="Новая марка">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <Label Text="Название марки:" FontAttributes="Bold"/>
            <Entry
                Text="{Binding Name}"
                Placeholder="Например: Honda"/>

            <Label Text="Страна производитель:" FontAttributes="Bold"/>
            <Entry
                Text="{Binding Country}"
                Placeholder="Например: Япония"/>

            <Button
                Text="Добавить марку"
                Command="{Binding SaveCommand}"
                Margin="0,16,0,0"
                BackgroundColor="#4CAF50"
                TextColor="White"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>